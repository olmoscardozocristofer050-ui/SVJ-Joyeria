# ===================================================
# VARIABLES DE ENTORNO - SVJ Joyería
# Copia este archivo como .env y completa los valores
# El archivo .env NUNCA se sube a GitHub
# ===================================================

# Motor de base de datos: sqlite (local/Render gratis) o mysql (producción)
DB_ENGINE=sqlite

# Solo necesario si DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=joyeria

# Seguridad de cookies: true en producción (HTTPS), false en desarrollo local
COOKIE_SECURE=false
